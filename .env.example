# HN Morning — env (none required for the extractive/mock path)

# Required on Vercel for /api/cron/generate
CRON_SECRET=

# Optional. If set, brief + asks use a cheap OpenAI chat model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Site-wide public ask cap (not per user)
ASK_LIMIT=15

# Optional override for local/tests
# DATA_DIR=/tmp/hn-morning
